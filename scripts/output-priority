#!/usr/bin/env python3
"""Automatic PipeWire output priority and interactive speaker TUI."""

from __future__ import annotations

import argparse
import json
import os
import selectors
import signal
import subprocess
import sys
from dataclasses import dataclass
from pathlib import Path
from typing import Any


APP_NAME = "output-priority"
CONFIG_HOME = Path(os.environ.get("XDG_CONFIG_HOME", Path.home() / ".config"))
RUNTIME_HOME = Path(os.environ.get("XDG_RUNTIME_DIR", f"/run/user/{os.getuid()}"))
CONFIG_PATH = CONFIG_HOME / APP_NAME / "config.json"
OVERRIDE_PATH = RUNTIME_HOME / APP_NAME / "override.json"
PACTL = os.environ.get("OUTPUT_PRIORITY_PACTL", "pactl")


@dataclass(frozen=True)
class Sink:
    name: str
    description: str
    index: int
    connected: bool = True


def run_pactl(*args: str, check: bool = True) -> subprocess.CompletedProcess[str]:
    return subprocess.run(
        [PACTL, *args], check=check, text=True, capture_output=True
    )


def discover_sinks() -> dict[str, Sink]:
    result = run_pactl("-f", "json", "list", "sinks")
    sinks: dict[str, Sink] = {}
    for raw in json.loads(result.stdout):
        name = str(raw.get("name", ""))
        if not name:
            continue
        availability = str(raw.get("availability", "unknown")).lower()
        ports = raw.get("ports") or []
        port_states = {
            str(port.get("availability", "unknown")).lower()
            for port in ports
            if isinstance(port, dict)
        }
        ports_unavailable = bool(port_states) and port_states <= {
            "no", "not available", "unavailable"
        }
        sinks[name] = Sink(
            name=name,
            description=str(raw.get("description") or name),
            index=int(raw.get("index", -1)),
            connected=availability not in {"no", "not available", "unavailable"}
            and not ports_unavailable,
        )
    return sinks


def empty_config() -> dict[str, Any]:
    return {"version": 1, "order": [], "disabled": [], "labels": {}}


def load_config() -> dict[str, Any]:
    try:
        raw = json.loads(CONFIG_PATH.read_text())
    except (FileNotFoundError, json.JSONDecodeError, OSError):
        return empty_config()
    config = empty_config()
    if isinstance(raw, dict):
        config["order"] = list(dict.fromkeys(map(str, raw.get("order", []))))
        config["disabled"] = list(dict.fromkeys(map(str, raw.get("disabled", []))))
        labels = raw.get("labels", {})
        if isinstance(labels, dict):
            config["labels"] = {str(key): str(value) for key, value in labels.items()}
    return config


def save_config(config: dict[str, Any]) -> None:
    CONFIG_PATH.parent.mkdir(parents=True, exist_ok=True)
    temporary = CONFIG_PATH.with_suffix(".tmp")
    temporary.write_text(json.dumps(config, indent=2, sort_keys=True) + "\n")
    temporary.replace(CONFIG_PATH)


def default_sink() -> str | None:
    result = run_pactl("info", check=False)
    if result.returncode:
        return None
    for line in result.stdout.splitlines():
        if line.startswith("Default Sink:"):
            return line.partition(":")[2].strip() or None
    return None


def merge_discovered(
    config: dict[str, Any], sinks: dict[str, Sink], current: str | None
) -> bool:
    changed = False
    order: list[str] = config["order"]
    labels: dict[str, str] = config["labels"]
    discovered = list(sinks.values())
    if not order:
        discovered.sort(key=lambda sink: (0 if sink.name == current else 1, sink.description))
    for sink in discovered:
        if labels.get(sink.name) != sink.description:
            labels[sink.name] = sink.description
            changed = True
        if sink.name not in order:
            order.append(sink.name)
            changed = True
    return changed


def load_override() -> str | None:
    try:
        value = json.loads(OVERRIDE_PATH.read_text()).get("sink")
        return str(value) if value else None
    except (FileNotFoundError, json.JSONDecodeError, OSError, AttributeError):
        return None


def set_override(sink: str | None) -> None:
    if sink is None:
        OVERRIDE_PATH.unlink(missing_ok=True)
        return
    OVERRIDE_PATH.parent.mkdir(parents=True, exist_ok=True)
    temporary = OVERRIDE_PATH.with_suffix(".tmp")
    temporary.write_text(json.dumps({"sink": sink}) + "\n")
    temporary.replace(OVERRIDE_PATH)


def usable_names(config: dict[str, Any], sinks: dict[str, Sink]) -> set[str]:
    disabled = set(config["disabled"])
    return {
        name for name, sink in sinks.items() if sink.connected and name not in disabled
    }


def choose_sink(
    config: dict[str, Any], sinks: dict[str, Sink], override: str | None
) -> tuple[str | None, str | None]:
    usable = usable_names(config, sinks)
    if override in usable:
        return override, override
    override = None
    for name in config["order"]:
        if name in usable:
            return name, override
    return None, override


def active_playback_sinks(sinks: dict[str, Sink]) -> set[str]:
    result = run_pactl("-f", "json", "list", "sink-inputs", check=False)
    if result.returncode:
        return set()
    by_index = {sink.index: name for name, sink in sinks.items()}
    active: set[str] = set()
    for stream in json.loads(result.stdout):
        if stream.get("corked") or stream.get("mute"):
            continue
        name = by_index.get(int(stream.get("sink", -1)))
        if name:
            active.add(name)
    return active


def volume_target(state: dict[str, Any]) -> str | None:
    """Pick override, then ranked active playback, then the automatic default."""
    if state["override"]:
        return state["override"]
    active = active_playback_sinks(state["sinks"])
    usable = usable_names(state["config"], state["sinks"])
    for name in state["config"]["order"]:
        if name in active and name in usable:
            return name
    return state["target"]


def reconcile(*, dry_run: bool = False) -> dict[str, Any]:
    sinks = discover_sinks()
    config = load_config()
    current = default_sink()
    config_changed = merge_discovered(config, sinks, current)
    override_before = load_override()
    target, override_after = choose_sink(config, sinks, override_before)
    if not dry_run:
        if config_changed:
            save_config(config)
        if override_after != override_before:
            set_override(override_after)
        if target and target != current:
            run_pactl("set-default-sink", target)
    return {
        "current": current,
        "target": target,
        "override": override_after,
        "sinks": sinks,
        "config": config,
    }


def wake_daemon() -> None:
    subprocess.run(
        ["systemctl", "--user", "kill", "--signal=SIGUSR1", "output-priority.service"],
        check=False,
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
    )


def daemon() -> None:
    wake_read, wake_write = os.pipe()

    def wake(_signum: int, _frame: Any) -> None:
        try:
            os.write(wake_write, b"x")
        except OSError:
            pass

    signal.signal(signal.SIGUSR1, wake)
    signal.signal(signal.SIGHUP, wake)
    reconcile()
    while True:
        subscription = subprocess.Popen(
            [PACTL, "subscribe"], stdout=subprocess.PIPE,
            stderr=subprocess.DEVNULL, text=True, bufsize=1
        )
        assert subscription.stdout is not None
        selector = selectors.DefaultSelector()
        selector.register(subscription.stdout, selectors.EVENT_READ)
        selector.register(wake_read, selectors.EVENT_READ)
        try:
            subscribed = True
            while subscribed and subscription.poll() is None:
                events = selector.select(timeout=30)
                if not events:
                    reconcile()
                for key, _mask in events:
                    if key.fileobj == wake_read:
                        os.read(wake_read, 4096)
                        reconcile()
                    else:
                        line = subscription.stdout.readline()
                        if not line:
                            subscribed = False
                        elif any(word in line for word in ("sink", "card", "server")):
                            reconcile()
        finally:
            selector.close()
            subscription.terminate()
            subscription.wait(timeout=5)


def print_status() -> None:
    state = reconcile(dry_run=True)
    selected = volume_target(state)
    print(f"Default:       {state['current'] or 'none'}")
    print(f"Automatic:     {state['target'] or 'none'}")
    print(f"Override:      {state['override'] or 'none'}")
    print(f"Volume target: {selected or 'none'}")
    print()
    disabled = set(state["config"]["disabled"])
    rank = 0
    for name in state["config"]["order"]:
        sink = state["sinks"].get(name)
        label = state["config"]["labels"].get(name, name)
        connection = "connected" if sink and sink.connected else "disconnected"
        if name in disabled:
            enabled = "disabled"
        else:
            rank += 1
            enabled = f"priority {rank}"
        print(f"{label}: {connection}, {enabled}")


def tui() -> None:
    try:
        from rich.text import Text
        from textual.app import App, ComposeResult
        from textual.containers import Container
        from textual.widgets import Footer, Header, Static
    except ImportError:
        print("The Textual package is required for the output TUI.", file=sys.stderr)
        raise SystemExit(1)

    class OutputApp(App[None]):
        TITLE = "Output Priority"
        SUB_TITLE = "PipeWire speaker manager"
        CSS = """
        Screen { background: #10141c; color: #d8dee9; }
        Header { background: #5e81ac; color: white; }
        #body { height: 1fr; margin: 1 2; border: round #4c566a; padding: 1 2; }
        #summary { height: 5; color: #88c0d0; margin-bottom: 1; }
        #devices { height: 1fr; }
        #help { height: 3; color: #81a1c1; border-top: solid #3b4252; padding-top: 1; }
        Footer { background: #2e3440; }
        """
        BINDINGS = [
            ("q", "quit", "Quit"), ("up", "previous", "Select up"),
            ("down", "next", "Select down"),
            ("k", "previous", "Select up"), ("j", "next", "Select down"),
            ("shift+up", "promote", "Raise priority"),
            ("shift+down", "demote", "Lower priority"),
            ("shift+k", "promote", "Raise priority"),
            ("shift+j", "demote", "Lower priority"),
            ("h", "promote", "Raise priority"),
            ("l", "demote", "Lower priority"),
            ("space", "override", "Use temporarily"),
            ("d", "toggle_disabled", "Enable/disable"),
            ("c", "clear_override", "Resume hierarchy"),
            ("r", "refresh", "Refresh"),
        ]

        def __init__(self) -> None:
            super().__init__()
            self.selected = 0
            self.state: dict[str, Any] = {}

        def compose(self) -> ComposeResult:
            yield Header()
            with Container(id="body"):
                yield Static(id="summary")
                yield Static(id="devices")
                yield Static(
                    "J/K select   Shift+J/K or H/L rank   Space temporary   D disable   "
                    "C automatic   Q quit", id="help"
                )
            yield Footer()

        @property
        def order(self) -> list[str]:
            return self.state.get("config", {}).get("order", [])

        def on_mount(self) -> None:
            self.refresh_state()
            self.set_interval(2.0, self.refresh_state)

        def refresh_state(self) -> None:
            try:
                self.state = reconcile(dry_run=True)
            except (subprocess.SubprocessError, json.JSONDecodeError) as error:
                self.notify(str(error), title="Could not read outputs", severity="error")
                return
            self.selected = max(0, min(self.selected, len(self.order) - 1))
            self.render_state()

        def render_state(self) -> None:
            current = self.state.get("current")
            target = self.state.get("target")
            override = self.state.get("override")
            volume = volume_target(self.state)
            config = self.state["config"]
            sinks: dict[str, Sink] = self.state["sinks"]
            labels: dict[str, str] = config["labels"]
            disabled = set(config["disabled"])
            ranked = [name for name in self.order if name not in disabled]
            priorities = {name: rank for rank, name in enumerate(ranked, start=1)}
            summary = Text()
            mode = "TEMPORARY OVERRIDE" if override else "AUTOMATIC HIERARCHY"
            summary.append(f"  {mode}\n", style="bold #ebcb8b" if override else "bold #a3be8c")
            summary.append("  Default: ", style="dim")
            summary.append(labels.get(target, target or "No usable output"), style="bold #88c0d0")
            summary.append("\n  Volume keys: ", style="dim")
            summary.append(labels.get(volume, volume or "No usable output"), style="bold #88c0d0")
            self.query_one("#summary", Static).update(summary)

            content = Text()
            if not self.order:
                content.append("No outputs have been discovered yet.", style="italic #d08770")
            for index, name in enumerate(self.order):
                sink = sinks.get(name)
                connected = bool(sink and sink.connected)
                pointer = "❯" if index == self.selected else " "
                rank = f"{priorities[name]:>2}" if name in priorities else " —"
                status = "● connected" if connected else "○ unplugged"
                status_style = "#a3be8c" if connected else "#616e88"
                flags = []
                if name == current: flags.append("DEFAULT")
                if name == override: flags.append("OVERRIDE")
                if name == volume: flags.append("VOLUME")
                if name in disabled: flags.append("DISABLED")
                line_style = "reverse" if index == self.selected else ""
                content.append(f"{pointer} {rank}  ", style=line_style)
                content.append(f"{labels.get(name, name):<34.34}", style=f"bold {line_style}")
                content.append(f" {status:<14}", style=f"{status_style} {line_style}")
                if flags:
                    content.append("  " + " · ".join(flags), style=f"bold #ebcb8b {line_style}")
                content.append("\n")
            self.query_one("#devices", Static).update(content)

        def selected_name(self) -> str | None:
            return self.order[self.selected] if self.order else None

        def persist(self) -> None:
            save_config(self.state["config"])
            wake_daemon()
            reconcile()
            self.refresh_state()

        def action_previous(self) -> None:
            if self.order:
                self.selected = (self.selected - 1) % len(self.order)
                self.render_state()

        def action_next(self) -> None:
            if self.order:
                self.selected = (self.selected + 1) % len(self.order)
                self.render_state()

        def move(self, offset: int) -> None:
            if not self.order:
                return
            destination = self.selected + offset
            if destination < 0 or destination >= len(self.order):
                return
            self.order[self.selected], self.order[destination] = (
                self.order[destination], self.order[self.selected]
            )
            self.selected = destination
            self.persist()

        def action_promote(self) -> None:
            self.move(-1)

        def action_demote(self) -> None:
            self.move(1)

        def action_toggle_disabled(self) -> None:
            name = self.selected_name()
            if not name:
                return
            disabled: list[str] = self.state["config"]["disabled"]
            if name in disabled:
                disabled.remove(name)
            else:
                disabled.append(name)
                if load_override() == name:
                    set_override(None)
            self.persist()

        def action_override(self) -> None:
            name = self.selected_name()
            sink = self.state["sinks"].get(name) if name else None
            if not sink or not sink.connected:
                self.notify("That output is not connected", severity="warning")
                return
            if name in self.state["config"]["disabled"]:
                self.notify("Enable that output first", severity="warning")
                return
            set_override(name)
            wake_daemon()
            reconcile()
            self.refresh_state()

        def action_clear_override(self) -> None:
            set_override(None)
            wake_daemon()
            reconcile()
            self.refresh_state()

        def action_refresh(self) -> None:
            self.state = reconcile()
            self.render_state()

    OutputApp().run()


def parse_args() -> argparse.Namespace:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument(
        "command", nargs="?", default="tui",
        choices=("tui", "daemon", "status", "reconcile", "volume-target")
    )
    parser.add_argument("--dry-run", action="store_true")
    return parser.parse_args()


def main() -> None:
    args = parse_args()
    if args.command == "daemon":
        daemon()
    elif args.command == "status":
        print_status()
    elif args.command == "reconcile":
        state = reconcile(dry_run=args.dry_run)
        print(state["target"] or "")
    elif args.command == "volume-target":
        print(volume_target(reconcile(dry_run=True)) or "")
    else:
        tui()


if __name__ == "__main__":
    main()
