#!/usr/bin/env python3
"""Copy/paste the latest completed download, or open the latest PDF."""

import argparse
import json
import os
from pathlib import Path
import subprocess
import sys
import time


PARTIAL_SUFFIXES = (".part", ".crdownload", ".download", ".tmp", ".filepart", ".aria2")


def latest_file(directory, pdf=False):
    candidates = []
    for path in directory.iterdir():
        if path.name.startswith(".") or path.suffix.lower() in PARTIAL_SUFFIXES:
            continue
        if pdf and path.suffix.lower() != ".pdf":
            continue
        if any(path.with_name(path.name + suffix).exists() for suffix in PARTIAL_SUFFIXES):
            continue
        try:
            if not path.is_file() or path.is_symlink():
                continue
            info = path.stat()
            if info.st_size:
                # ctime also catches fresh downloads with an old server mtime.
                candidates.append((max(info.st_ctime_ns, info.st_mtime_ns), path.name, path))
        except FileNotFoundError:
            continue
    if not candidates:
        kind = "PDFs" if pdf else "files"
        raise RuntimeError(f"No completed {kind} in {directory}")
    return max(candidates)[2]


def active_window():
    result = subprocess.run(
        ["hyprctl", "-j", "activewindow"], check=True, capture_output=True,
        text=True, timeout=5,
    )
    return json.loads(result.stdout).get("address")


def notify(message):
    subprocess.run(["notify-send", "Latest download", message, "-t", "3000"], check=False)


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("action", choices=("paste", "copy", "pdf"), nargs="?", default="paste")
    args = parser.parse_args()
    try:
        result = subprocess.run(
            ["xdg-user-dir", "DOWNLOAD"], check=True, capture_output=True,
            text=True, timeout=5,
        )
        directory = Path(result.stdout.strip() or Path.home() / "Downloads")
        path = latest_file(directory, pdf=args.action == "pdf")
        if args.action == "pdf":
            os.execvp("zathura", ["zathura", str(path)])

        target = active_window() if args.action == "paste" else None
        # Offer a file reference, so compatible apps attach/copy the file.
        subprocess.run(
            ["wl-copy", "--type", "text/uri-list"],
            input=path.absolute().as_uri() + "\r\n", text=True, check=True, timeout=5,
        )
        if args.action == "paste" and target:
            time.sleep(0.15)
            if active_window() == target:
                result = subprocess.run(
                    ["hyprctl", "dispatch", "sendshortcut", f"CTRL, V, address:{target}"],
                    check=True, capture_output=True, text=True, timeout=5,
                )
                if result.stdout.strip() != "ok":
                    raise RuntimeError(result.stdout.strip() or result.stderr.strip())
                return 0
        notify(f"Copied file: {path.name}")
        return 0
    except (OSError, ValueError, RuntimeError, subprocess.SubprocessError) as exc:
        print(f"latest-download: {exc}", file=sys.stderr)
        notify(str(exc))
        return 1


if __name__ == "__main__":
    sys.exit(main())
