#!/usr/bin/env bash
set -euo pipefail

action="${1:-}"

case "$action" in
  raise|lower|mute-toggle) ;;
  *)
    echo "Usage: output-volume {raise|lower|mute-toggle}" >&2
    exit 2
    ;;
esac

sink="$(output-priority volume-target)"

if [[ -z "$sink" ]]; then
  echo "No usable audio output found" >&2
  exit 1
fi

if [[ "$action" == "mute-toggle" ]]; then
  exec swayosd-client --device "$sink" --output-volume mute-toggle
fi

exec swayosd-client --device "$sink" --output-volume "$action" --max-volume 150
