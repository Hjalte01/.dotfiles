configuration {
    show-icons: true;
    font: "JetBrainsMono Nerd Font 12";
    display-drun: "🔍 Apps:";
}

@import "../dotfiles-theme/current/colors.rasi"

* {
    background-color: @base;
    text-color: @foreground;
    border-color: @accent;
}

window {
    width: 35%;
    border: 2px solid;
    border-color: @accent;
    border-radius: 12px;
    background-color: @base;
    padding: 0px; /* Remove padding from the window edge */
}

mainbox {
    background-color: transparent;
    padding: 15px; /* Move the padding here instead */
}

inputbar {
    padding: 12px;
    border-radius: 8px;
    background-color: @surface;
}

prompt {
    background-color: inherit;
    text-color: @accent; /* Bright Purple to match your border */
    font: "JetBrainsMono Nerd Font Bold 12";
}

entry {
    background-color: inherit;
    text-color: @foreground; /* Bright White/Gray for the text you type */
}

message {
    padding: 10px 12px 0 12px;
    background-color: transparent;
}

message textbox {
    background-color: transparent;
    text-color: @foreground;
}

listview {
    lines: 8;
    margin: 15px 0 0 0;
}

element {
    padding: 10px;
    border-radius: 8px;
}

element selected {
    background-color: @accent;
    text-color: @base;
}
